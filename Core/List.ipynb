   "source": [
    "# [1, 2, 2, 3, 4, 4, 5]\n",
    "def remove_duplicates(numbers):\n",
    "    result = []\n",
    "\n",
    "    for n in numbers:\n",
    "        if n not in result:\n",
    "            result.append(n)\n",
    "\n",
    "    return result\n",
    "\n",
    "remove_duplicates([1, 2, 2, 3, 4, 4, 5])\n"
   ]
